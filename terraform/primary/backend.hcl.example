# Copy to backend.hcl (gitignored) and fill in from terraform/bootstrap outputs.
# Then: terraform init -backend-config=backend.hcl
#
# Auth: export the Customer Secret Key (from bootstrap output
# state_aws_access_key_id / state_aws_secret_access_key) as AWS-style env vars
# BEFORE running init/plan/apply:
#   export AWS_ACCESS_KEY_ID=<state_aws_access_key_id>
#   export AWS_SECRET_ACCESS_KEY=<state_aws_secret_access_key>

bucket = "k8s-lab-tfstate"                                   # bootstrap output: state_bucket
key    = "primary/terraform.tfstate"
region = "us-ashburn-1"

endpoints = {
  s3 = "https://YOUR_NAMESPACE.compat.objectstorage.us-ashburn-1.oraclecloud.com"
}

use_path_style              = true

# Works against OCI's S3-compat API ONLY with these env vars set (else the
# AWS SDK v2 sends aws-chunked uploads that OCI rejects with HTTP 501):
#   export AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
#   export AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED
use_lockfile = true

skip_region_validation      = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
