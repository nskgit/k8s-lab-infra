# Copy to backend.hcl (gitignored) and fill in from terraform/bootstrap
# outputs. Then: terraform init -backend-config=backend.hcl
#
# Auth: reuses the same ~/.oci/config profile the provider block already
# uses (see providers.tf's config_file_profile) — no separate credential
# needed. Native backend (Terraform >= 1.12); see backend.tf for why this
# replaced the old S3-compatible config.

bucket    = "k8s-lab-tfstate"   # bootstrap output: state_bucket
namespace = "YOUR_NAMESPACE"    # bootstrap output: state_namespace (the OCI tenancy's Object Storage namespace)
key       = "primary/terraform.tfstate"
region    = "us-ashburn-1"
auth      = "APIKey"
config_file_profile = "DEFAULT"
