# Copy to terraform.tfvars (gitignored) and fill in real values before plan/apply.

# ---- Identity ----
tenancy_ocid = "ocid1.tenancy.oc1..xxxx"
region       = "us-ashburn-1"

# ---- Compartment (from bootstrap output: compartment_ocid) ----
# For plan-only review with placeholder OCID, this is fine: terraform plan
# doesn't validate OCID existence server-side for resources that are being
# newly created. Replace with the real value after bootstrap applies.
compartment_ocid = "ocid1.compartment.oc1..PLACEHOLDER"
compartment_name = "k8s-lab"

# ---- Naming ----
name_prefix = "k8s-lab"

# ---- Network ----
vcn_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.0.0/24"
cp_subnet_cidr     = "10.0.1.0/24"
worker_subnet_cidr = "10.0.2.0/24"

# Your public IP as /32 — the ONLY source allowed to SSH the bastion.
# Get it once with: curl -s ifconfig.me
my_ip_cidr = "203.0.113.7/32"

# Set true only when temporarily using the Phase-A hosted CI runner path.
allow_bastion_public_ssh = false

# ---- Access ----
# Contents of ~/.ssh/k8s_lab_ed25519.pub — trusted by bastion/cp/workers.
ssh_public_key = "ssh-ed25519 AAAA...replace-with-your-pub-key... k8s-lab"

# ---- Availability domain ----
# 0-indexed. Change to 1 or 2 if AD 0 doesn't have Always-Free A1.Flex capacity.
availability_domain_index = 0

# ---- Shapes / sizing (Always Free defaults; override only if paying) ----
# bastion_shape           = "VM.Standard.E2.1.Micro"
# cp_shape                = "VM.Standard.A1.Flex"
# cp_ocpus                = 2
# cp_memory_in_gbs        = 8
# worker_shape            = "VM.Standard.A1.Flex"
# worker_count            = 2
# worker_ocpus            = 1
# worker_memory_in_gbs    = 8
# boot_volume_size_in_gbs = 50

# Optional: pin the control-plane's private IP (inside cp_subnet_cidr) so
# it's deterministic instead of DHCP-assigned. Leave unset on a fresh
# tenancy's first apply, then pin it to whatever OCI assigned if you want
# later rebuilds to keep the same address.
# cp_private_ip = "10.0.1.10"

# ---- LB ----
# nodeport_http = 30080
