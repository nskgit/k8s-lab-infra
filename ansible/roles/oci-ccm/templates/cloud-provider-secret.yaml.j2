apiVersion: v1
kind: Secret
metadata:
  name: oci-cloud-controller-manager
  namespace: kube-system
type: Opaque
stringData:
  cloud-provider.yaml: |-
    auth:
      # Instance Principals — CCM authenticates as cp's OCI instance,
      # granted by the iam-ccm Terraform module. No static keys.
      useInstancePrincipals: true

    compartment: {{ compartment_ocid }}
    vcn: {{ vcn_id }}
    loadBalancer:
      subnet1: {{ public_subnet_id }}
      # securityListManagementMode: None means CCM doesn't touch our NSG
      # rules — we own the NSG matrix in Terraform. NSG rules for a
      # future type=LoadBalancer service must be pre-created and
      # attached via the oci-network-security-groups annotation.
      securityListManagementMode: None
