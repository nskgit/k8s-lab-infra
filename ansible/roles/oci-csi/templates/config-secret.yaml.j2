apiVersion: v1
kind: Secret
metadata:
  # NOTE: name is oci-volume-provisioner, not oci-cloud-controller-manager
  # (CCM's). CSI does NOT read CCM's secret — separate envelope + different
  # data key (config.yaml, not cloud-provider.yaml).
  name: oci-volume-provisioner
  namespace: kube-system
type: Opaque
stringData:
  config.yaml: |-
    auth:
      useInstancePrincipals: true

    compartment: {{ compartment_ocid }}
    vcn: {{ vcn_id }}
    loadBalancer:
      subnet1: {{ public_subnet_id }}
      securityListManagementMode: None
